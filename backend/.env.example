PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/haulmind_tcl
JWT_SECRET=put-a-long-random-string-here
JWT_EXPIRES=12h
CORS_ORIGIN=https://haulmindin.wayneesolutions.com
COMPANY_NAME=TCL Logistics
# optional: customer's own colour on PDFs
PDF_ACCENT=
# Link sent in WhatsApp/SMS. Must be the real live domain, otherwise messages go without a track link.
PUBLIC_TRACK_URL=https://haulmindin.wayneesolutions.com/track

# Notifications: log | whatsapp | msg91
# log = nothing is really sent; messages are saved with status "logged" (not "sent").
# Switch to whatsapp only after the 4 Meta templates (hm_lr_booked, hm_lr_arrived, hm_lr_delivered,
# hm_payment_reminder) are approved and WA_TOKEN / WA_PHONE_ID are filled.
NOTIFY_PROVIDER=log
WA_TOKEN=
WA_PHONE_ID=
WA_LANG=hi
MSG91_AUTH_KEY=
MSG91_SENDER=
MSG91_TPL_LR_BOOKED=
MSG91_TPL_LR_UNLOADED=
MSG91_TPL_LR_DELIVERED=
MSG91_TPL_PAYMENT_REMINDER=

# Backup every day 5 AM IST
BACKUP_DIR=./backups
BACKUP_CRON=0 5 * * *
BACKUP_KEEP_DAYS=30
# Copy each backup off the server (recommended). Needs the AWS CLI + an IAM role/keys with S3 access:
# BACKUP_SYNC_CMD=aws s3 sync ./backups s3://YOUR-BUCKET/haulmind-tcl --only-show-errors
BACKUP_SYNC_CMD=

# Payment reminder: checked daily, sent to each party once every 15 days
REMINDER_CRON=30 10 * * *
REMINDER_EVERY_DAYS=15
# true = remind only once a bill is past its due date (bill date + party credit days)
REMINDER_ONLY_OVERDUE=true

# First run only
SEED_OWNER_PASSWORD=
