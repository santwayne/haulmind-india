PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/haulmind_tcl
JWT_SECRET=put-a-long-random-string-here
JWT_EXPIRES=12h
CORS_ORIGIN=https://YOUR-APP-DOMAIN
COMPANY_NAME=TCL Logistics
# optional: customer's own colour on PDFs
PDF_ACCENT=
PUBLIC_TRACK_URL=https://YOUR-APP-DOMAIN/track

# Notifications: log | whatsapp | msg91
NOTIFY_PROVIDER=log
WA_TOKEN=
WA_PHONE_ID=
WA_LANG=hi
MSG91_AUTH_KEY=
MSG91_SENDER=
MSG91_TPL_LR_BOOKED=
MSG91_TPL_LR_UNLOADED=
MSG91_TPL_LR_DELIVERED=
MSG91_TPL_PAYMENT_REMINDER=

# Backup every day 5 AM IST
BACKUP_DIR=./backups
BACKUP_CRON=0 5 * * *
BACKUP_KEEP_DAYS=30

# Payment reminder: checked daily, sent to each party once every 15 days
REMINDER_CRON=30 10 * * *
REMINDER_EVERY_DAYS=15

# First run only
SEED_OWNER_PASSWORD=
